# Copie este ficheiro para `frontend/.env.local` e ajuste se necessário.
# (O Vite só lê ficheiros .env dentro da pasta frontend/.)
# A API documentada não requer autenticação. Nunca coloque segredos em variáveis VITE_*:
# ficam visíveis no código enviado para o navegador.

# URL base da API do Detetive da Chuva (sem barra final).
# Se não estiver definida, a aplicação usa esta URL documentada.
VITE_API_BASE_URL=https://detetive-da-chuva.onrender.com

# Tempo máximo de espera por pedido, em milissegundos (entre 5000 e 300000).
# Predefinição: 120000 (120 s). Observado: arranque a frio do servidor ~54 s;
# /api/v1/advisory entre 8 e 22 s, com pedidos que excederam 60 s e 90 s.
VITE_API_TIMEOUT_MS=120000
